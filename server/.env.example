# Copy this file to .env and fill in real values, or run:
#   ./scripts/setup-google-oauth.sh
# which walks you through creating a free Google OAuth client and writes these for you.
# Used for per-user YouTube Music playlist export via Google's device-code
# flow and the YouTube Data API v3 playlist endpoints.

YTMUSIC_OAUTH_CLIENT_ID=
YTMUSIC_OAUTH_CLIENT_SECRET=

# Runtime hardening. Keep these explicit in production; localhost defaults are
# only for local development and tests.
AUDELLE_ENV=development
# Comma-separated browser origins allowed to call the API.
AUDELLE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated Host header values accepted by the API.
AUDELLE_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Set true only when the reverse proxy forwards HTTPS correctly and uvicorn is
# started with --proxy-headers.
AUDELLE_FORCE_HTTPS=false
